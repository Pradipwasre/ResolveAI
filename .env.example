# Copy to .env and fill in. Never commit .env.

# "fake" runs fully offline with a rule-based stand-in for the LLM (good for a first run).
# "openai" uses real models: set OPENAI_API_KEY too.
LLM_PROVIDER=fake
OPENAI_API_KEY=

# From @BotFather on Telegram. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# Dashboard login (created on first start)
ADMIN_EMAIL=admin@resolveai.dev
ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=replace-with-another-long-random-string-32-chars-min

# Cost guardrails in USD
DAILY_BUDGET_USD=5
PER_CUSTOMER_DAILY_BUDGET_USD=0.25

# Models (check https://platform.openai.com/docs/models for current names)
LLM_MODEL_FAST=gpt-5.4-mini
LLM_MODEL_SMART=gpt-5.4
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts

# Only on a server with a public HTTPS address (set automatically on AWS)
PUBLIC_BASE_URL=
